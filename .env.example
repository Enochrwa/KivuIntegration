# Copy to .env and fill for local runs. In GitHub Actions, set these as repository
# variables or secrets (see README).

# Base URL of the container app (staging or local). Required.
CYPRESS_BASE_URL=http://localhost:5173

# Optional: Admin portal URL if different from container (e.g. separate admin app).
# CYPRESS_ADMIN_URL=https://admin-staging.your-container.com

# Test user for login. Required for specs that call cy.loginAs().
CYPRESS_ADMIN_EMAIL=your-test-user@example.com
CYPRESS_ADMIN_PASSWORD=your-test-password

# Additional portal users (store admin, clerk, analyst). Shared password.
CYPRESS_USER_PASSWORD=user-password
CYPRESS_STORE_ADMIN_EMAIL=store-admin@example.com
CYPRESS_STORE_CLERK_EMAIL=clerk@example.com
CYPRESS_STORE_ANALYST_EMAIL=analyst@example.com

# Optional: default language prefix (e.g. en, fr). Routes use /:lang/...
CYPRESS_DEFAULT_LANG=en
